############################ medications CRUD api calls ############################

    # Admin: View all medications list
    GET http://localhost:8000/api/v1/medications/
    Content-Type: application/json

    ###

    # Clinic Manager/Doctor: View clinic medications list
    GET http://localhost:8000/api/v1/medications/?clinic_id=1
    Content-Type: application/json

    ###

    # Doctor: View patient medications list
    GET http://localhost:8000/api/v1/medications/?clinic_id=1&patient_id=5
    Content-Type: application/json

    ###

    # Admin: Create base medication
    POST http://localhost:8000/api/v1/medications/
    Content-Type: application/json

    {
        "medication_name": "TEST",
        "medication_form": "Tablet",
        "medication_unit": "mg"
    }

    ###

    # Clinic Manager: Add medication to clinic
    POST http://localhost:8000/api/v1/medications/
    Content-Type: application/json

    {
        "medication_name": "TEST",
        "medication_form": "Tablet",
        "medication_unit": "mg",
        "clinic_id": 1
    }

    ###

    # Doctor: Assign medication to patient
    POST http://localhost:8000/api/v1/medications/
    Content-Type: application/json

    {
        "medication_name": "TEST",
        "medication_form": "Tablet",
        "medication_unit": "mg",
        "clinic_id": 1,
        "patient_id": 5
    }

    ###

    # Admin: Get base medication details
    GET http://localhost:8000/api/v1/medications/1999022183/
    Content-Type: application/json

    ###

    # Clinic Manager: Get clinic medication details
    GET http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1
    Content-Type: application/json

    ###

    # Doctor/Patient: Get patient medication details with schedule
    GET http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1&patient_id=5
    Content-Type: application/json

    ###

    # Admin: Update base medication
    PUT http://localhost:8000/api/v1/medications/1999022183/
    Content-Type: application/json

    {
        "name": "Aspirin Updated",
        "form": "Capsule",
        "unit": "mg"
    }

    ###

    # Doctor: Assign/Update patient medication schedule
    PUT http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1&patient_id=5
    Content-Type: application/json

    {
        "frequency": "daily",
        "frequency_data": {
            "dates": [],
            "days": [],
            "time": ["08:00", "20:00"]
        },
        "start_date": "2026-01-15 08:00:00",
        "end_date": "2026-02-15 08:00:00",
        "dosage": "100mg"
    }

    ###

    # Doctor: Assign/Update patient medication with weekly schedule
    PUT http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1&patient_id=5
    Content-Type: application/json

    {
        "frequency": "weekly",
        "frequency_data": {
            "dates": [],
            "days": ["monday", "wednesday", "friday"],
            "time": ["10:00", "14:00"]
        },
        "start_date": "2026-01-15 10:00:00",
        "end_date": "2026-02-15 10:00:00",
        "dosage": "1 tablet"
    }

    ###

    # Admin: Delete base medication
    DELETE http://localhost:8000/api/v1/medications/1999022183/

    ###

    # Clinic Manager: Remove medication from clinic
    DELETE http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1

    ###

    # Doctor: Remove medication from patient
    DELETE http://localhost:8000/api/v1/medications/1999022183/?clinic_id=1&patient_id=5

    ###

