########################### modules API calls ###########################

    # ============ MODULES CRUD ============

    # List all modules (GET)
    GET http://localhost:8000/api/v1/modules/

    ###

    # Create a new module (POST)
    POST http://localhost:8000/api/v1/modules/
    Content-Type: application/json

    {
        "module_name": "New Module",
        "module_description": "Description for new module"
    }

    ###

    # Get specific module details (GET)
    GET http://localhost:8000/api/v1/modules/9/

    ###

    # Update a module (PUT)
    PUT http://localhost:8000/api/v1/modules/9/
    Content-Type: application/json

    {
        "module_name": "Updated Module Name",
        "module_description": "Updated description for the module"
    }

    ###

    # Partially update a module (PATCH)
    PATCH http://localhost:8000/api/v1/modules/9/
    Content-Type: application/json

    {
        "module_description": "Only updating description"
    }

    ###

    # Delete a module (DELETE)
    DELETE http://localhost:8000/api/v1/modules/9/

    ###

    # ============ CLINIC MODULES ============

    # List all modules for a clinic (GET)
    GET http://localhost:8000/api/v1/clinics/1/modules/

    ###

    # Add a module to a clinic (POST)
    POST http://localhost:8000/api/v1/clinics/1/modules/
    Content-Type: application/json

    {
        "module_id": 7
    }

    ###

    # Get specific clinic module details (GET)
    GET http://localhost:8000/api/v1/clinics/1/modules/4/

    ###

    # Toggle clinic module active status (PATCH - no body)
    PATCH http://localhost:8000/api/v1/clinics/1/modules/4/

    ###

    # Set clinic module active status explicitly (PATCH - with body)
    PATCH http://localhost:8000/api/v1/clinics/1/modules/4/
    Content-Type: application/json

    {
        "is_active": false
    }

    ###

    # Remove module from clinic (DELETE)
    DELETE http://localhost:8000/api/v1/clinics/1/modules/7/

    ###

    # ============ PATIENT MODULES ============

    # List all modules for a patient (GET)
    GET http://localhost:8000/api/v1/clinics/1/patients/5/modules/

    ###

    # Add a module to a patient (POST)
    POST http://localhost:8000/api/v1/clinics/1/patients/5/modules/
    Content-Type: application/json

    {
        "module_id": 4
    }

    ###

    # Get specific patient module details (GET)
    GET http://localhost:8000/api/v1/clinics/1/patients/5/modules/3/

    ###

    # Toggle patient module active status (PATCH - no body)
    PATCH http://localhost:8000/api/v1/clinics/1/patients/5/modules/3/

    ###

    # Set patient module active status explicitly (PATCH - with body)
    PATCH http://localhost:8000/api/v1/clinics/1/patients/5/modules/3/
    Content-Type: application/json

    {
        "is_active": true
    }

    ###

    # Remove module from patient (DELETE)
    DELETE http://localhost:8000/api/v1/clinics/1/patients/5/modules/4/

